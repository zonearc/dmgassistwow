+-- Resources move: a press pays its cost and grants its gain (spell data), Energy / Focus / Mana come back over
+-- time, and a spell you can't afford reads "not enough" (IsSpellUsable's noPower), like in the game. Before this,
+-- resources stayed at 60% all fight and the check couldn't play Devourer (Void Ray forever, 2026-11-11).
+local REGEN = { [0] = 2, [2] = 5, [3] = 10 } -- per second, as % of the maximum
+local function Afford(info)
+  for pt, amount in pairs(info and info.cost or {}) do
+    if (mock.power[pt] or 0) < amount then
+      return false
+    end
+  end
+  return true
+end
+
+local function Pay(info)
+  for pt, amount in pairs(info and info.cost or {}) do
+    mock.power[pt] = math.max(0, (mock.power[pt] or 0) - amount)
+  end
+  for pt, amount in pairs(info and info.gain or {}) do
+    mock.power[pt] = math.min(mock.powerMax[pt] or 100, (mock.power[pt] or 0) + amount)
+  end
+end
+
