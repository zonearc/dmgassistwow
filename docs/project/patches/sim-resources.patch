+-- Resources move: a press pays its cost and grants its gain (spell data), Energy / Focus / Mana come back over
+-- time, and a spell you can't afford reads "not enough" (IsSpellUsable's noPower), like in the game. Before this,
+-- resources stayed at 60% all fight and the check couldn't play Devourer (Void Ray forever, 2026-11-11).
+local REGEN = { [0] = 2, [2] = 5, [3] = 10 } -- per second, as % of the maximum
+-- Which resources a spec really spends: Energy (rogues, Feral, Windwalker, Brewmaster), Focus (hunters), and any
+-- other resource one of its own spells generates. Shared spell data carries costs a spec never pays in the game
+-- (Mistweaver's Tiger Palm still lists Windwalker's Energy and Chi); Mana is left out (a 2-minute fight never
+-- runs a caster dry in the game).
+local uses = {}
+local function Uses(key, record)
+  local set = {}
+  if key:find("^rogue_") or key == "druid_feral" or key == "monk_windwalker" or key == "monk_brewmaster" then
+    set[3] = true
+  end
+  if key:find("^hunter_") then
+    set[2] = true
+  end
+  for _, info in pairs(record.info or {}) do
+    for pt in pairs(type(info) == "table" and info.gain or {}) do
+      if pt ~= 0 then
+        set[pt] = true
+      end
+    end
+  end
+  return set
+end
+
+local function Afford(info)
+  for pt, amount in pairs(info and info.cost or {}) do
+    if uses[pt] and (mock.power[pt] or 0) < amount then
+      return false
+    end
+  end
+  return true
+end
+
+local function Pay(info)
+  for pt, amount in pairs(info and info.cost or {}) do
+    if uses[pt] then
+      mock.power[pt] = math.max(0, (mock.power[pt] or 0) - amount)
+    end
+  end
+  for pt, amount in pairs(info and info.gain or {}) do
+    mock.power[pt] = math.min(mock.powerMax[pt] or 100, (mock.power[pt] or 0) + amount)
+  end
+end
+
 local function Fight(ns, key, record, book, scenario)
